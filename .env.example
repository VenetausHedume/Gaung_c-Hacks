# MediCheck Supabase Configuration
# Copy this file to .env and populate with your project credentials.
# NEVER commit your actual .env file or service role key to version control.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key-here
